<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Profile</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex items-center justify-center">

  <div class="w-full max-w-lg bg-slate-800/80 backdrop-blur rounded-2xl shadow-2xl p-8">

    <!-- PROFILE IMAGE -->
    <div class="flex justify-center -mt-10 mb-4">
      <img
        src="<%= user.photo %>"
        alt="Profile Picture"
        class="w-32 h-32 rounded-full object-cover border-4 border-slate-700 shadow-lg bg-slate-700"
      />
    </div>

    <!-- USER INFO -->
    <div class="text-center">
      <h1 class="text-2xl font-bold text-white">
        <%= user.name %>
      </h1>

      <p class="text-slate-400 text-sm mt-1">
        @<%= user.username %>
      </p>

      <p class="text-slate-300 text-sm mt-1">
        <%= user.email %>
      </p>
    </div>

    <!-- DIVIDER -->
    <div class="border-t border-slate-700 my-6"></div>

    <!-- GAME STATS -->
    <div class="grid grid-cols-2 gap-4 text-center">
      <div class="bg-slate-700/60 rounded-xl p-4">
        <p class="text-2xl font-bold text-indigo-400">
          <%= user.gamesPlayed %>
        </p>
        <p class="text-sm text-slate-300">Games Played</p>
      </div>

      <div class="bg-slate-700/60 rounded-xl p-4">
        <p class="text-2xl font-bold text-green-400">
          <%= user.highestScore %>
        </p>
        <p class="text-sm text-slate-300">Highest Score</p>
      </div>

      <div class="bg-slate-700/60 rounded-xl p-4">
        <p class="text-2xl font-bold text-yellow-400">
          <%= user.totalScore || 0 %>
        </p>
        <p class="text-sm text-slate-300">Total Score</p>
      </div>

      <div class="bg-slate-700/60 rounded-xl p-4">
        <p class="text-2xl font-bold text-cyan-400">
          <%= user.gamesPlayed === 0 ? 0 : (user.totalScore / user.gamesPlayed).toFixed(2) %>
        </p>
        <p class="text-sm text-slate-300">Avg Score</p>
      </div>
    </div>

    <!-- TOKENS / COINS -->
    <div class="mt-6 bg-slate-700/60 rounded-xl p-4 text-center">
      <p class="text-xl font-semibold text-orange-400">
        🎯 <%= user.coins || user.token %>
      </p>
      <p class="text-sm text-slate-300">Available Tokens</p>
    </div>

    <!-- ACTION BUTTONS -->
    <div class="mt-8 flex flex-col gap-3">
      <a
        href="/quiz/start"
        class="bg-indigo-600 hover:bg-indigo-500 transition text-white py-2 rounded-lg text-center font-medium"
      >
        Play Quiz
      </a>

      <form action="/api/v1/users/logout" method="POST">
        <button
          type="submit"
          class="w-full bg-red-600 hover:bg-red-500 transition text-white py-2 rounded-lg font-medium"
        >
          Logout
        </button>
      </form>
    </div>

  </div>

</body>
</html>
