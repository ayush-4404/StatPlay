<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cricket Quiz</title>


  <script src="https://cdn.tailwindcss.com"></script>


  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

  <div class="relative min-h-screen w-full overflow-hidden">

    <img
      src= "https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?q=80&w=2505&auto=format&fit=crop"
      class="absolute inset-0 w-full h-full object-cover blur-sm scale-110"
      alt="cricket"
    />

    <div class="relative z-10 min-h-screen flex flex-col items-center justify-center bg-black/50 text-white px-6">

      <h1 class="typing text-4xl md:text-6xl font-bold text-center">
        Welcome to the Ultimate Cricket Quiz 🏏
      </h1>

      <p class="mt-6 text-lg md:text-xl opacity-90 text-center">
        Test your cricket knowledge. Are you ready?
      </p>

      <div class="mt-12 flex flex-col md:flex-row gap-6">

        <a href="/register"
           class="w-64 h-24 bg-slate-800/80 backdrop-blur-md
                  border border-slate-600 rounded-xl
                  flex items-center justify-center
                  text-2xl font-semibold
                  hover:bg-green-500 hover:text-black
                  transition-all duration-300 hover:scale-105">
          Register
        </a>

         <a href="/login"
           class="w-64 h-24 bg-slate-800/80 backdrop-blur-md
                  border border-slate-600 rounded-xl
                  flex items-center justify-center
                  text-2xl font-semibold
                  hover:bg-yellow-400 hover:text-black
                  transition-all duration-300 hover:scale-105">
          Sign In
        </a>

      </div>

    </div>
  </div>

</body>
</html>
