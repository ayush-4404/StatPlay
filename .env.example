# Email Configuration for Nodemailer
# You need to add these to your existing .env file

# For Gmail (Recommended for testing)
# 1. Go to Google Account settings
# 2. Enable 2-Step Verification
# 3. Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=StatPlay

# Alternative: For Mailtrap (Testing only - emails won't be delivered to real inboxes)
# Sign up at https://mailtrap.io
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USERNAME=your-mailtrap-username
# EMAIL_PASSWORD=your-mailtrap-password
# EMAIL_FROM=noreply@statplay.com
# EMAIL_FROM_NAME=StatPlay

# Alternative: For SendGrid
# Sign up at https://sendgrid.com
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USERNAME=apikey
# EMAIL_PASSWORD=your-sendgrid-api-key
# EMAIL_FROM=your-verified-sender@yourdomain.com
# EMAIL_FROM_NAME=StatPlay
